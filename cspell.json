{
  "$schema": "./node_modules/@cspell/cspell-types/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "files": ["**/*.md", "**/*.py", "**/*.sql", "**/*.yml"],
  "enableGlobDot": true,
  "ignorePaths": ["node_modules/**", ".serverless/**"],
  "useGitignore": true,
  "languageSettings": [
    {
      "languageId": "python",
      "ignoreRegExpList": ["/^\\s*from.*import/gm"]
    }
  ],
  "words": [
    "athena",
    "avenida",
    "bashhistory",
    "calle",
    "carrera",
    "CELLBORDER",
    "CELLSPACING",
    "commandhistory",
    "datehour",
    "dockerized",
    "dpage",
    "eafit",
    "firehose",
    "fontcolor",
    "fontname",
    "fontsize",
    "graphviz",
    "gómez",
    "idat",
    "iend",
    "ihdr",
    "iibbbbb",
    "jsonserde",
    "labelloc",
    "lakehouse",
    "lhead",
    "medallion",
    "medellín",
    "neato",
    "nodesep",
    "openx",
    "penwidth",
    "pereira",
    "pgadmin",
    "pgdatabase",
    "pghost",
    "pgpassword",
    "pguser",
    "postgres",
    "psql",
    "pylint",
    "pyproject",
    "pérez",
    "rankdir",
    "ranksep",
    "serde",
    "serdeproperties",
    "sofía",
    "tblproperties",
    "timespec",
    "trunc",
    "yapf"
  ]
}
